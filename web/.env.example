# 环境变量示例 —— 复制为 .env 后按需修改（.env 不会进仓库）
#
# 本地开发用 SQLite，零依赖即可跑通。
DATABASE_URL="file:./dev.db"

# 数据层模式：mock = 用本地假数据；live = 走真实后端
NEXT_PUBLIC_API_MODE=mock

# live 模式下的 API 基址。同项目内置 API 时保持 /api 即可
NEXT_PUBLIC_API_BASE=/api

# TTS 语音合成（可选，不配置则只有本地已下载的 114 个词能发音）
# BAIDU_TTS_KEY=
# BAIDU_TTS_SECRET=

# 上线后请改成真实域名，用于 SEO 的 canonical / sitemap
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
